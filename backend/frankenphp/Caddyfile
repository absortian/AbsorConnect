{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
	}

	root /app/public
	encode zstd br gzip

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# Sonda de vida, deliberadamente estática: si pasara por el worker PHP, un
	# pico de carga la haría fallar y kubelet reiniciaría el pod justo cuando peor
	# viene. La readiness va contra /api/health, que sí atraviesa PHP y Postgres.
	@healthz path /healthz
	respond @healthz "OK" 200

	@phpRoute {
		not path /healthz
		not file {path}
	}
	rewrite @phpRoute index.php

	@frontController path index.php
	php @frontController {
		{$FRANKENPHP_SITE_CONFIG}

		worker {
			file ./public/index.php
			{$FRANKENPHP_WORKER_CONFIG}
		}
	}

	file_server {
		hide *.php
	}
}
