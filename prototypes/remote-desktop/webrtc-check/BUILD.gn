  deps = [
    "//api:create_modular_peer_connection_factory",
    "//api:enable_media",
    "//api:data_channel_interface",
    "//api:jsep",
    "//api:make_ref_counted",
    "//api:media_stream_interface",
    "//api:rtp_parameters",
    "//api:peer_connection_interface",
    "//api:rtp_sender_interface",
    "//api:rtp_transceiver_interface",
    "//api:set_local_description_observer_interface",
    "//api:set_remote_description_observer_interface",
    "//api/audio_codecs:builtin_audio_decoder_factory",
    "//api/audio_codecs:builtin_audio_encoder_factory",
    "//api/environment:environment_factory",
    "//api/video:adapted_video_track_source",
    "//api/video:video_frame",
    "//api/video_codecs:video_encoder_factory_template",
    "//api/video_codecs:video_encoder_factory_template_libvpx_vp8_adapter",
    "//api/video_codecs:video_decoder_factory_template",
    "//api/video_codecs:video_decoder_factory_template_libvpx_vp8_adapter",
