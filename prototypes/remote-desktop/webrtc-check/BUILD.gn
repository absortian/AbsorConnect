    "//api:make_ref_counted",
    "//api:peer_connection_interface",
    "//api/environment:environment_factory",
    "//rtc_base:ssl_adapter",
    "//rtc_base:threading",
  ]
}

rtc_executable("auth_check") {
  sources = [ "auth_check.cc" ]
  deps = [ "//third_party/boringssl:boringssl" ]
}

rtc_executable("factory_check") {
  sources = [ "factory_check.cc" ]
