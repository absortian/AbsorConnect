[Unit]
Description=AbsorConnect Lab - entrada fija con concesion corta
After=systemd-logind.service

[Service]
Type=notify
ExecStart=/opt/absorconnect-seat-authority-lab/absor-input-lease-probe-lab
User=root
Group=root
Restart=no
KillMode=control-group
TimeoutStartSec=5s
TimeoutStopSec=1s
WatchdogSec=500ms
WatchdogSignal=SIGKILL
NotifyAccess=main
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
BindReadOnlyPaths=/tmp/.X11-unix
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
DevicePolicy=closed
DeviceAllow=/dev/uinput rw
UMask=0077
LimitCORE=0
MemoryMax=96M
TasksMax=16
WorkingDirectory=/
StandardOutput=journal
StandardError=journal
