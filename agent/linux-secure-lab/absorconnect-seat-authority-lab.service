[Unit]
Description=AbsorConnect owned VM local X11 authority laboratory
Requires=absorconnect-seat-authority-lab.socket
After=absorconnect-seat-authority-lab.socket systemd-logind.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
User=root
Group=root
ExecStart=/opt/absorconnect-seat-authority-lab/absor-seat-authority-lab
WatchdogSec=3s
WatchdogSignal=SIGKILL
NotifyAccess=main
Restart=on-failure
RestartSec=1s
RestartPreventExitStatus=78
TimeoutStartSec=5s
TimeoutStopSec=3s
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service memfd_create
SystemCallErrorNumber=EPERM
LimitCORE=0
LimitFSIZE=65536
MemoryMax=96M
TasksMax=16
StandardOutput=null
StandardError=journal
