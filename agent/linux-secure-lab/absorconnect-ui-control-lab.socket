[Unit]
Description=AbsorConnect explicit local stop laboratory socket
PartOf=absorconnect-secure-lab.service

[Socket]
ListenStream=/run/absorconnect-ui-control-lab/control.sock
SocketUser=absorconnect-lab
SocketGroup=absorlab
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=yes
Accept=no
Service=absorconnect-secure-lab.service
Backlog=4
